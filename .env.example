# Copy this file to .env and fill in your real keys.
# .env is gitignored; .env.example is checked in as a template.

# Required — Groq (free tier at https://console.groq.com) — used for the 8B router LLM
GROQ_API_KEY=gsk_paste_your_key_here

# Required — Google Gemini (free tier at https://aistudio.google.com/apikey) — used for the answerer LLM
GEMINI_API_KEY=AIzaSy_paste_your_key_here

# Optional — LangSmith observability (free tier at https://smith.langchain.com)
# Leave LANGSMITH_TRACING=false to disable tracing for local dev.
LANGSMITH_API_KEY=lsv2_paste_your_key_here
LANGSMITH_PROJECT=askmydocs-dev
LANGSMITH_TRACING=true
